# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Source documents (may be private) — folder kept, contents ignored
data/*
!data/.gitkeep

# ChromaDB persistence (derived from your documents)
vectorstore/
*.sqlite3
*.db
chroma/

# Streamlit
.streamlit/secrets.toml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
