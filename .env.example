# Gemini provides text generation; HuggingFace provides local embeddings.
# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings (optional: token is only needed for gated HF models) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=

# --- Storage ---
CHROMA_COLLECTION=rag_documents
DATA_DIR=data
CHROMA_DIR=vectorstore

# --- Retrieval tuning ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SIMILARITY_TOP_K=3
